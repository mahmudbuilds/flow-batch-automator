{
  "manifest_version": 3,
  "name": "Flow Batch Automator",
  "version": "1.1.4",
  "description": "Production-grade batch generation and sequential asset downloader for Google Flow (flow.google.com).",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "styles.css",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ]
    }
  ],
  "action": {
    "default_title": "Flow Batch Automator (Click to Toggle Panel)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
